<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <RootNamespace>CloudNimble.Breakdance.Tests.Azurite</RootNamespace>
        <AssemblyName>CloudNimble.Breakdance.Tests.Azurite</AssemblyName>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Data.Tables" Version="12.10.0" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
        <PackageReference Include="Azure.Storage.Queues" Version="12.22.0" />
        <PackageReference Include="Humanizer.Core" Version="3.*" NoWarn="NU1608" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.Breakdance.Azurite\Breakdance.Azurite.csproj" />
        <ProjectReference Include="..\CloudNimble.Breakdance.Extensions.MSTest2\Breakdance.Extensions.MSTest2.csproj" />
    </ItemGroup>

    <!--
        Self-import: this project lives in the same solution as Breakdance.Azurite and
        consumes it via <ProjectReference>, which doesn't auto-import the package's
        build/$(PackageId).targets file the way <PackageReference> does. The Import below
        manually runs EnsureAzuriteInstalled so our own tests get the same npm-install
        behavior NuGet consumers get for free.

        DO NOT copy this pattern into your own project. If you reference Breakdance.Azurite
        via PackageReference (the normal way), NuGet handles this automatically.
    -->
    <Import Project="..\CloudNimble.Breakdance.Azurite\Breakdance.Azurite.targets" />

</Project>
